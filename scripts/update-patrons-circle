#!/usr/bin/php
<?
require_once(__DIR__ . '/../lib/Core.php');

use Safe\DateTimeImmutable;
use function Safe\getopt;

function Usage(): void{
	Cli::PrintHelp(
		usage: '[command]update-patrons-circle[/]',
		description: 'Update the Patrons Circle to end Patron status for Patrons whose term has completed without a renewal.',
	);
}

if(!isset($argc, $argv)){
	Cli::ExitWithError('Command-line arguments are unavailable.');
}

$restIndex = 0;
$options = getopt('h', ['help'], $restIndex);
$restIndex ??= $argc;

if(isset($options['h']) || isset($options['help'])){
	Usage();
}

$parameters = array_slice($argv, $restIndex);

if(sizeof($parameters) != 0){
	Usage();
}

// Turn off the slow query log for this session.
Db::Query('set session slow_query_log = 0');

// First, email yearly Patrons who signed up via Stripe and whose renewals are due 2 weeks from now.
$upcomingRenewalSubscriptions = Db::Query('select * from Subscriptions where Processor = ? and CycleType = ? and NextPaymentAt is not null and date(NextPaymentAt) = date(utc_timestamp() + interval 2 week) and EndedAt is null', [Enums\PaymentProcessorType::Stripe, Enums\CycleType::Yearly], Subscription::class);

$ebooksThisYear = null;

foreach($upcomingRenewalSubscriptions as $subscription){
	$ebooksThisYear ??= Ebook::GetEbookCreatedAfterCount(new DateTimeImmutable('-1 year'));
	$subscription->SendYearlyRenewalEmail($ebooksThisYear);
}

// Allow 75 days for monthly fund subscriptions, and 45 days for other Fractured Atlas subscriptions.
Db::Query('
	update Subscriptions s
	left join (
		select SubscriptionId, max(CreatedAt) as LastPaidAt, max(IsDonorAdvisedFund) as IsDonorAdvisedFund
		from Payments
		where RefundedAt is null
		group by SubscriptionId
	) latest on latest.SubscriptionId = s.SubscriptionId
	set s.EndedAt = coalesce(latest.LastPaidAt + interval (case when latest.IsDonorAdvisedFund = true then 75 else 45 end) day, utc_timestamp())
	where s.Processor = ?
	and s.EndedAt is null
	and (
		latest.LastPaidAt is null
		or latest.LastPaidAt <= utc_timestamp() - interval (case when latest.IsDonorAdvisedFund = true then 75 else 45 end) day
	)
', [Enums\PaymentProcessorType::FracturedAtlas]);

// Find grants whose linked funding has expired, then check for a paid replacement before removing benefits.
$expiredPatrons = Db::Query('
	select patron.* from Patrons patron
	left join Subscriptions s on s.SubscriptionId = patron.SubscriptionId
	left join Payments gift on gift.PaymentId = patron.QualifyingPaymentId
	where patron.EndedAt is null
	and (
		(patron.QualifyingPaymentId is not null and (gift.PaymentId is null or gift.RefundedAt is not null or gift.CreatedAt <= utc_timestamp() - interval 1 year))
		or (patron.SubscriptionId is not null and (
			s.SubscriptionId is null or not exists (
				select * from Payments renewal
				where renewal.SubscriptionId = s.SubscriptionId and renewal.RefundedAt is null
				and (
					(s.Processor = ? and renewal.CreatedAt > utc_timestamp() - interval (case when renewal.IsDonorAdvisedFund = true then 75 else 45 end) day)
					or (s.Processor = ? and (
						(s.CycleType = ? and utc_timestamp() < renewal.CreatedAt + interval 1 month + interval 15 day)
						or (s.CycleType = ? and utc_timestamp() < renewal.CreatedAt + interval 1 year + interval 15 day)
					))
				)
			)
		))
	)
', [Enums\PaymentProcessorType::FracturedAtlas, Enums\PaymentProcessorType::Stripe, Enums\CycleType::Monthly, Enums\CycleType::Yearly], Patron::class);

if(sizeof($expiredPatrons) > 0){
	$ebooksThisYear ??= Ebook::GetEbookCreatedAfterCount(new DateTimeImmutable('-1 year'));

	Db::QueryInt('select count(*) from Ebooks where EbookCreatedAt >= utc_timestamp() - interval 1 year');

	foreach($expiredPatrons as $patron){
		if(!$patron->ReconcileFunding()){
			$patron->End($ebooksThisYear);
		}
	}
}
